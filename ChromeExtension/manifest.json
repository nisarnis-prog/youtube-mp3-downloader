{
  "manifest_version": 3,
  "name": "Nisar MP3 Downloader Companion",
  "version": "1.0.0",
  "key": "",
  "description": "Send supported YouTube links to the local YouTube MP3 Downloader.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nisar MP3 Downloader Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}