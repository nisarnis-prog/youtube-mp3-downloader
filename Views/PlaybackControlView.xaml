<UserControl x:Class="YouTube_MP3_Downloader.Views.PlaybackControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="NOW PLAYING"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFaint}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="Select MP3"
                            Style="{StaticResource SecondaryButton}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Command="{Binding SelectMp3Command}"
                            Margin="0,0,6,0"/>
                    <Button Content="Select Folder"
                            Style="{StaticResource SecondaryButton}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Command="{Binding SelectMusicFolderCommand}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock Text="{Binding NowPlayingTitle, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding NowPlayingTitle}"/>
                <TextBlock Text="{Binding PlaybackError, Mode=OneWay}"
                           FontSize="11.5"
                           Foreground="{DynamicResource StatusFailed}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPlaybackError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding PositionText, Mode=OneWay}"
                           MinWidth="46"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Slider x:Name="SeekSlider"
                        Grid.Column="1"
                        Margin="12,0"
                        Style="{StaticResource PlaybackSlider}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds, Mode=OneWay}"
                        Value="{Binding PlaybackProgress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding HasDuration, Mode=OneWay}"
                        IsMoveToPointEnabled="False"
                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                        ToolTip="Click or drag to seek"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding DurationText, Mode=OneWay}"
                           MinWidth="46"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Grid>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0">
                <Button Command="{Binding PlayPauseCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Width" Value="34"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="ToolTip" Value="Play"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                    <Setter Property="ToolTip" Value="Pause"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <TextBlock Text="&#x25B6;"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="&#x2759;&#x2759;"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
                <Button Content="&#x25A0;"
                        Style="{StaticResource IconButton}"
                        Width="34"
                        Height="34"
                        FontSize="13"
                        ToolTip="Stop playback"
                        Command="{Binding StopPlaybackCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Open Folder"
                        Style="{StaticResource SecondaryButton}"
                        Height="34"
                        Padding="12,0"
                        FontSize="12"
                        ToolTip="Show file in Explorer (selects the MP3)"
                        Command="{Binding OpenDownloadedFileCommand}"/>
            </StackPanel>

            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    BorderBrush="{DynamicResource GridBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalTracks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,6">
                        <Run Text="FOLDER TRACKS" FontSize="11" FontWeight="SemiBold"/>
                        <Run Text="{Binding LocalFolderInfo, Mode=OneWay}"
                             FontSize="11"
                             Foreground="{DynamicResource TextFaint}"/>
                    </TextBlock>
                    <ListBox x:Name="LocalTracksList"
                             Grid.Row="1"
                             ItemsSource="{Binding LocalTracks}"
                             SelectedItem="{Binding SelectedLocalTrack, Mode=TwoWay}"
                             MaxHeight="152"
                             MouseDoubleClick="LocalTracksList_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarSelectedBack}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource IconButton}"
                                            Width="26"
                                            Height="26"
                                            FontSize="11"
                                            ToolTip="Play this track"
                                            Command="{Binding DataContext.PlayLocalTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="&#x25B6;"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="12.5"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding FilePath}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>