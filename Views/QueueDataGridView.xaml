<UserControl x:Class="YouTube_MP3_Downloader.Views.QueueDataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid ItemsSource="{Binding Items}"
              AlternationCount="1000000">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="#" Width="48">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowNumberConverter}, Mode=OneWay}"
                                   Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Title" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold"
                                   ToolTip="{Binding Title}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="URL" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Url, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   ToolTip="{Binding Url}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Status" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusWaiting}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Preparing">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusRunning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusRunning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Converting">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusConverting}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusCompleted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusFailed}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusWaiting}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Progress" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="6"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         HorizontalAlignment="Stretch"/>
                            <TextBlock FontSize="10.5"
                                       Foreground="{DynamicResource TextFaint}"
                                       Margin="0,3,0,0"
                                       Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0}%}"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Speed" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Speed, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Size" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FileSize, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Error" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource StatusFailed}"
                                   ToolTip="{Binding ErrorMessage}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Actions" Width="224">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Width="30"
                                    Height="30"
                                    FontSize="12"
                                    Command="{Binding DataContext.TogglePlayItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanPlay}"
                                    Margin="0,0,5,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Width" Value="30"/>
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="ToolTip" Value="Play"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentTrackPlaying}" Value="True">
                                                <Setter Property="ToolTip" Value="Pause"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCurrentTrack}" Value="True"/>
                                                    <Condition Binding="{Binding IsCurrentTrackPlaying}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="ToolTip" Value="Resume"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <TextBlock Text="&#x25B6;" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentTrackPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="&#x2759;&#x2759;" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentTrackPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <Button Content="Cancel"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanCancel}"
                                    Margin="0,0,5,0"/>
                            <Button Content="Retry"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanRetry}"
                                    Margin="0,0,5,0"/>
                            <Button Content="Remove"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanRemove}"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>